# Resend (https://resend.com) — contact form emails. Server-only, never NEXT_PUBLIC_.
# Create an API key in the Resend dashboard. Free tier is enough for a portfolio.
RESEND_API_KEY=
# Optional. Defaults to Resend's test sender (only delivers to your Resend account email).
# After you verify a domain: Srinjani <hello@yourdomain.com>
RESEND_FROM_EMAIL=
# Optional. Defaults to the inbox in lib/contact.ts
CONTACT_TO_EMAIL=

# Google Apps Script web app URL from Deploy → Web app (server-only). Optional backup log.
# Example: https://script.google.com/macros/s/<deployment-id>/exec
GOOGLE_SHEETS_WEBAPP_URL=
